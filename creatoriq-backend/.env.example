# CreatorIQ backend configuration.
# Copy this file to ".env" and fill in POSTGRES_PASSWORD. NEVER commit ".env".
# The same POSTGRES_* values are used by docker compose AND by the application.

# --- Application ---
# One of: development, test, production
APP_ENV=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=creatoriq
# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=project
POSTGRES_DB=creatoriq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: a full SQLAlchemy URL. If set, it overrides the POSTGRES_* values for the
# application and Alembic (docker compose still uses POSTGRES_*).
# Accepted schemes: postgresql://  or  postgresql+psycopg://
# DATABASE_URL=

# --- Optional tuning ---
# Seconds to wait when opening a database connection (1-60).
# DB_CONNECT_TIMEOUT=3
# Log every SQL statement (development only).
# DB_ECHO=false

# --- Tests only ---
# URL of a DISPOSABLE database whose name ends in "_test" (see README). The integration
# tests create and drop the app/ds/synthetic schemas in it. Leave unset to skip them.
# TEST_DATABASE_URL=